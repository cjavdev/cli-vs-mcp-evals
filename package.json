{
  "name": "cli-vs-mcp-evals",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/suite.d.ts",
      "default": "./dist/suite.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./eval": {
      "types": "./dist/eval.d.ts",
      "default": "./dist/eval.js"
    },
    "./scorers/*": {
      "types": "./dist/scorers/*.d.ts",
      "default": "./dist/scorers/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "generate:suites": "npx tsx scripts/generate-suite-index.ts",
    "eval": "npm run generate:suites && npx braintrust eval src/evals/e2e.eval.ts",
    "eval:all": "npm run generate:suites && npx braintrust eval src/evals/run-all.ts",
    "eval:github": "EVAL_SUITE=github npm run eval",
    "eval:stainless": "EVAL_SUITE=stainless npm run eval",
    "eval:stripe": "EVAL_SUITE=stripe npm run eval",
    "eval:believe": "EVAL_SUITE=believe npm run eval",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@anthropic-ai/sdk": "^1.3.0",
    "@cjavdev/believe": "^0.31.0",
    "autoevals": "^0.4.1",
    "braintrust": "^3.39.0",
    "dotenv": "^18.0.9",
    "ts-node": "^10.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
